# ─────────────────────────────────────────────────────────────────────────────
# StockVision AI — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockvision_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ── Alpha Vantage (optional — leave blank to use yfinance only) ───────────
ALPHA_VANTAGE_API_KEY=

# ── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///models/mlflow.db
MLFLOW_EXPERIMENT_NAME=stockvision_ai

# ── Application settings ────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/stockvision.log

# ── Data settings ───────────────────────────────────────────────────────────
HISTORICAL_START_DATE=2019-01-01
DATA_SOURCE=yfinance

# ── Streamlit ────────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501

# ── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
