# =============================================================================
# StockVision AI — Supabase Environment Configuration
# =============================================================================
# Get these values from: Supabase Dashboard → Settings → Database
# =============================================================================

# ── Supabase PostgreSQL Connection ───────────────────────────────────────
# Go to: https://app.supabase.com → Your Project → Settings → Database
# Copy the "Connection string" (URI format) OR fill in fields below

DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ── Alternative: Use the full connection string directly ──────────────────
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase API (optional — for REST API access) ────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── MLflow ──────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///models/mlflow.db
MLFLOW_EXPERIMENT_NAME=stockvision_ai

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/stockvision.log

# ── Data ────────────────────────────────────────────────────────────────
HISTORICAL_START_DATE=2019-01-01
DATA_SOURCE=yfinance

# ── Streamlit ────────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501

# ── FastAPI ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
